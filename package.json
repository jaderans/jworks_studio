{
  "name": "jworks-studio",
  "private": true,
  "version": "0.1.0",
  "description": "JoshWorks Studio: the studio app for JoshWorks: jobs, clients, quotes, contracts, invoices, payments, designer payouts, reports and marketing.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "emulators": "npx --yes firebase-tools emulators:start --only auth,firestore --project demo-jwcamp",
    "check": "npm run typecheck && npm test",
    "test:rules": "npx --yes firebase-tools emulators:exec --only firestore --project demo-jwcamp \"node firebase/rules.check.mjs\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "fflate": "^0.8.3",
    "firebase": "^12.19.0",
    "lucide-react": "^1.48.0",
    "pdfmake": "^0.3.11",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/pdfmake": "^0.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "typescript": "~5.9",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "workbox-window": "^7.4.1"
  }
}
